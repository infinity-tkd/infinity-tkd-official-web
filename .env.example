# Copy to `.env.local` for local development, and set the same names in your hosting provider's
# environment settings (e.g. Vercel -> Project -> Settings -> Environment Variables).
#
# Contact, coaching-application and incubator-pitch forms deliver through the FIRST channel that is
# configured below. In production, if NO channel is configured the forms return an error that points
# visitors to WhatsApp/phone instead of silently losing their message. In local development, with
# nothing configured, submissions are simply logged to the terminal.

# --- Option 1: Telegram bot (recommended: instant phone notification) ---------------------------
# Create a bot with @BotFather, add it to your staff chat, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Option 2: Generic webhook (Zapier / Make / n8n / Google Apps Script / Slack-compatible) -----
# Receives a JSON POST: { source, title, fields: {...}, body, timestamp }
CONTACT_WEBHOOK_URL=
# Optional dedicated webhooks (fall back to CONTACT_WEBHOOK_URL when empty)
CAREER_WEBHOOK_URL=
INCUBATOR_WEBHOOK_URL=
